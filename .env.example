# ==============================================================================
# SHOP MANU PLATFORM ENVIRONMENT VARIABLES
# ==============================================================================

# InsForge Backend Configuration
VITE_INSFORGE_URL=https://your-app.region.insforge.app
VITE_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# Google Maps Platform (Phase 6 Integration)
# ------------------------------------------------------------------------------
# 1. Google Cloud Console: Enable "Maps JavaScript API"
# 2. Application Restrictions: Restrict by HTTP referrer (e.g. http://localhost:5173/*, https://your-domain.com/*)
# 3. API Restrictions: Restrict key to "Maps JavaScript API"
# If this key is empty, the application will run in non-blocking fallback mode:
# - Restaurant physical address, coordinates, and Google Maps directions remain active
# - Owner can still configure coordinates using validated inputs and locality presets
VITE_GOOGLE_MAPS_API_KEY=
